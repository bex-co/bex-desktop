name: bex
title: Bex
base: core24
version: "$RELEASE_VERSION"
summary: The editor for what's next
description: |
  Bex is a modern open-source code editor, built from the ground up in Rust with
  a GPU-accelerated renderer. We help you build software faster than ever before.
grade: stable
confinement: classic
compression: lzo
website: https://bex.co/
source-code: https://github.com/bex-co/bex-desktop
issues: https://github.com/bex-co/bex-desktop/issues
contact: https://github.com/bex-co/bex-desktop/issues

parts:
  bex:
    plugin: dump
    source: "https://github.com/bex-co/bex-desktop/releases/download/bex-v$RELEASE_VERSION/bex-linux-x86_64.tar.gz"

    source-subdir: bex.app

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  bex:
    command: usr/bin/bex
    common-id: co.bex.Bex
    environment:
      ZED_BUNDLE_TYPE: snap
