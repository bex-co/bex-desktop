#!/usr/bin/env python3

import argparse
import json
import os
from pathlib import Path
import plistlib
import subprocess
import tempfile


def verify(condition, message):
    if not condition:
        raise RuntimeError(message)


def main():
    parser = argparse.ArgumentParser(description="Verify a mounted Bex installer before release")
    parser.add_argument("dmg", type=Path)
    parser.add_argument("--arch", required=True, choices=["arm64", "x86_64"])
    parser.add_argument("--app-name", default="Bex", choices=["Bex", "Bex Dev", "Bex Preview", "Bex Nightly"])
    arguments = parser.parse_args()
    with tempfile.TemporaryDirectory(prefix="bex-dmg-verification-") as directory:
        mount_path = Path(directory) / "mount"
        subprocess.run([
            "hdiutil", "attach", str(arguments.dmg.resolve()), "-readonly",
            "-nobrowse", "-mountpoint", str(mount_path),
        ], check=True, stdout=subprocess.DEVNULL)
        try:
            volume = plistlib.loads(subprocess.check_output(["diskutil", "info", "-plist", str(mount_path)]))
            verify(volume["VolumeName"] == arguments.app_name, "Unexpected DMG volume name")
            entries = sorted(os.listdir(mount_path))
            verify(entries == sorted(["Applications", arguments.app_name + ".app"]), f"Unexpected installer entries: {entries}")
            verify(os.readlink(mount_path / "Applications") == "/Applications", "Incorrect Applications shortcut")
            app_path = mount_path / (arguments.app_name + ".app")
            verify(not app_path.is_symlink(), "Application must be a real bundle")
            with (app_path / "Contents/Info.plist").open("rb") as source:
                info = plistlib.load(source)
            expected_identifier = "co.bex.Bex" + arguments.app_name.removeprefix("Bex").replace(" ", "-")
            verify(info["CFBundleIdentifier"] == expected_identifier, "Unexpected application identifier")
            verify(info["CFBundleDisplayName"] == arguments.app_name, "Unexpected application display name")
            verify(info["CFBundleExecutable"] == "bex", "Unexpected application executable")
            icon = Path(info["CFBundleIconFile"])
            if not icon.suffix:
                icon = icon.with_suffix(".icns")
            verify((app_path / "Contents/Resources" / icon).is_file(), "Missing application icon")
            subprocess.run(["lipo", str(app_path / "Contents/MacOS/bex"), "-verify_arch", arguments.arch], check=True)
            subprocess.run(["codesign", "--verify", "--deep", "--strict", str(app_path)], check=True)
            print(json.dumps({
                "dmg": str(arguments.dmg.resolve()), "volume": volume["VolumeName"],
                "entries": entries, "identifier": info["CFBundleIdentifier"],
                "architecture": arguments.arch, "signature": "valid", "result": "PASS",
            }, indent=2))
        finally:
            subprocess.run(["hdiutil", "detach", str(mount_path)], check=True, stdout=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
